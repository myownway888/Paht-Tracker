<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Japji Sahib Path Tracker</title>
  
  <!-- Firebase SDKs for Auto-Sync -->
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --accent: #38bdf8;
      --gold: #f59e0b;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --success: #22c55e;
      --danger: #ef4444;
      --border: #334155;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 700px;
      display: flex;
      flex-direction: flex-direction;
      flex-direction: column;
      gap: 20px;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    h1, h2 {
      margin: 0 0 12px 0;
      color: var(--gold);
      text-align: center;
    }

    .tracker-box {
      text-align: center;
      padding: 20px 0;
    }

    .counter-display {
      font-size: 3.5rem;
      font-weight: bold;
      color: var(--accent);
      margin: 10px 0;
    }

    .btn {
      background-color: var(--gold);
      color: #000;
      border: none;
      padding: 12px 24px;
      font-size: 1.1rem;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.1s, opacity 0.2s;
    }

    .btn:hover { opacity: 0.9; }
    .btn:active { transform: scale(0.98); }
    .btn-small { padding: 8px 16px; font-size: 0.9rem; }
    .btn-danger { background-color: var(--danger); color: #fff; }

    .input-group {
      display: flex;
      gap: 10px;
      margin-top: 15px;
      justify-content: center;
    }

    input[type="password"], input[type="number"], input[type="date"] {
      background-color: #090d16;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 1rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--text-muted);
      font-size: 0.85rem;
      text-transform: uppercase;
    }

    .admin-panel {
      border: 1px solid var(--gold);
      display: none;
    }

    .admin-panel.active {
      display: block;
    }

    .sync-status {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 5px;
    }
  </style>
</head>
<body>

<div class="container">
  
  <!-- Header & Public Tracker -->
  <div class="card tracker-box">
    <h1>ੴ Japji Sahib Tracker</h1>
    <p style="color: var(--text-muted);">Daily Path Count Tracker</p>
    
    <div class="counter-display" id="totalCountDisplay">0</div>
    <p>Total Paths Completed Today</p>

    <button class="btn" onclick="addSinglePath()">+ Add 1 Path</button>
    <div class="sync-status" id="syncStatus">Status: Saved Locally</div>
  </div>

  <!-- Entry History Log -->
  <div class="card">
    <h2>Completed Entries</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Paths Done</th>
          <th>Last Update</th>
        </tr>
      </thead>
      <tbody id="entriesTable">
        <tr>
          <td colspan="3" style="text-align: center; color: var(--text-muted);">No entries logged yet.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Admin Protection Box -->
  <div class="card">
    <h2>Admin Controls</h2>
    <div id="adminAuthBox" class="input-group">
      <input type="password" id="adminPasswordInput" placeholder="Enter Admin Password">
      <button class="btn btn-small" onclick="unlockAdmin()">Unlock Controls</button>
    </div>
    <p id="authError" style="color: var(--danger); font-size: 0.85rem; text-align: center; display: none; margin-top: 8px;">
      Incorrect Password.
    </p>

    <!-- Admin Panel (Hidden until password unlocked) -->
    <div id="adminPanel" class="admin-panel card" style="margin-top: 15px;">
      <h3 style="color: var(--accent); margin-top: 0;">Admin Management Panel</h3>
      
      <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px; font-size: 0.9rem;">Set Custom Count for Specific Date:</label>
        <div class="input-group" style="justify-content: flex-start;">
          <input type="date" id="adminDateInput">
          <input type="number" id="adminCountInput" placeholder="Path Count" min="0">
          <button class="btn btn-small" onclick="saveAdminEntry()">Update Entry</button>
        </div>
      </div>

      <button class="btn btn-small btn-danger" onclick="resetAllData()">Reset All Tracker Data</button>
    </div>
  </div>

</div>

<script>
  // DEFAULT ADMIN PASSWORD: Set to 2626 (hidden in password input box)
  const ADMIN_PASS = "2626";

  // Data State
  let pathData = JSON.parse(localStorage.getItem('japji_path_data')) || {};

  // Firebase Realtime DB Setup (Optional: Replace URL with your actual database URL)
  const firebaseConfig = {
    databaseURL: "https://YOUR-DATABASE-NAME-default-rtdb.firebaseio.com"
  };

  let db = null;
  try {
    firebase.initializeApp(firebaseConfig);
    db = firebase.database();
    initFirebaseSync();
  } catch(e) {
    console.log("Firebase not configured. Running in Local Storage mode.");
  }

  function getTodayKey() {
    const today = new Date();
    return today.toISOString().split('T')[0];
  }

  function saveData() {
    localStorage.setItem('japji_path_data', JSON.stringify(pathData));
    
    // Sync to Cloud/Firebase if configured
    if (db) {
      db.ref("japji_tracker/data").set(pathData);
    }
    renderUI();
  }

  function addSinglePath() {
    const today = getTodayKey();
    if (!pathData[today]) {
      pathData[today] = { count: 0, updatedAt: new Date().toLocaleTimeString() };
    }
    pathData[today].count += 1;
    pathData[today].updatedAt = new Date().toLocaleTimeString();
    saveData();
  }

  function renderUI() {
    const today = getTodayKey();
    const todayCount = pathData[today] ? pathData[today].count : 0;
    
    document.getElementById('totalCountDisplay').innerText = todayCount;

    const tbody = document.getElementById('entriesTable');
    const keys = Object.keys(pathData).sort().reverse();

    if (keys.length === 0) {
      tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-muted);">No entries logged yet.</td></tr>`;
      return;
    }

    tbody.innerHTML = keys.map(dateKey => `
      <tr>
        <td><strong>${dateKey}</strong></td>
        <td><span style="color: var(--accent); font-weight: bold;">${pathData[dateKey].count}</span></td>
        <td>${pathData[dateKey].updatedAt || 'N/A'}</td>
      </tr>
    `).join('');
  }

  function unlockAdmin() {
    const inputPass = document.getElementById('adminPasswordInput').value;
    const errorMsg = document.getElementById('authError');
    const adminPanel = document.getElementById('adminPanel');

    if (inputPass === ADMIN_PASS) {
      adminPanel.classList.add('active');
      errorMsg.style.display = 'none';
      document.getElementById('adminAuthBox').style.display = 'none';
      document.getElementById('adminDateInput').value = getTodayKey();
    } else {
      errorMsg.style.display = 'block';
    }
  }

  function saveAdminEntry() {
    const selectedDate = document.getElementById('adminDateInput').value;
    const customCount = parseInt(document.getElementById('adminCountInput').value, 10);

    if (!selectedDate || isNaN(customCount)) {
      alert("Please enter a valid date and count.");
      return;
    }

    pathData[selectedDate] = {
      count: customCount,
      updatedAt: new Date().toLocaleTimeString() + ' (Admin Overridden)'
    };

    saveData();
    alert(`Updated entry for ${selectedDate} to ${customCount} paths.`);
  }

  function resetAllData() {
    if (confirm("Are you sure you want to delete all stored Japji Sahib path entries?")) {
      pathData = {};
      saveData();
    }
  }

  function initFirebaseSync() {
    if (!db) return;
    const syncStatus = document.getElementById('syncStatus');
    
    db.ref("japji_tracker/data").on("value", (snapshot) => {
      const cloudData = snapshot.val();
      if (cloudData) {
        pathData = cloudData;
        localStorage.setItem('japji_path_data', JSON.stringify(pathData));
        syncStatus.innerText = "Status: Live Synced via Cloud";
        syncStatus.style.color = "#22c55e";
        renderUI();
      }
    }, (error) => {
      syncStatus.innerText = "Status: Saved Locally";
    });
  }

  // Initial Load
  renderUI();
</script>

</body>
</html>
